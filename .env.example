# Core endpoints
BASE_URL=https://your-frontend-url.example.com
BACKEND_URL=https://your-backend-url.example.com

# Backend test reset auth
TEST_RESET_SECRET=replace-me

# Test credentials
TEST_USER_EMAIL=test.user@example.com
